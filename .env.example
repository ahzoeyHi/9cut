# ==========================================
# 9Cut 口播视频自动生成系统 - 环境变量配置
# ==========================================
# 复制此文件为 .env 并修改相应配置

# ------------------------------------------
# 服务器配置
# ------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------
# 数据库配置
# ------------------------------------------
DATABASE_PATH=./database.sqlite

# ------------------------------------------
# 文件存储配置
# ------------------------------------------
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_FILE_SIZE=100MB

# ------------------------------------------
# AI 服务配置
# ------------------------------------------
# 默认 AI 服务提供商: openai, claude, gemini, qwen, volcengine
DEFAULT_AI_SERVICE=openai

# OpenAI 配置
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude 配置
# CLAUDE_API_KEY=sk-ant-xxx
# CLAUDE_BASE_URL=https://api.anthropic.com

# Gemini 配置
# GEMINI_API_KEY=xxx

# 通义千问配置
# QWEN_API_KEY=xxx

# 火山引擎配置
# VOLCENGINE_API_KEY=xxx

# ------------------------------------------
# 安全配置
# ------------------------------------------
# API 密钥加密密钥 - 生产环境务必修改！
API_KEY_ENCRYPTION_SECRET=your-secret-key-change-in-production

# ------------------------------------------
# 日志配置
# ------------------------------------------
# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ------------------------------------------
# FFmpeg 配置
# ------------------------------------------
# FFmpeg 可执行文件路径 (如果已添加到 PATH 可留空)
# FFMPEG_PATH=/usr/bin/ffmpeg
