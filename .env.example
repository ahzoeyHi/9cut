# ==========================================
# 9Cut 口播视频自动生成系统 - 环境变量配置
# ==========================================
# 复制此文件为 .env 并修改相应配置

# ------------------------------------------
# 服务器配置
# ------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------
# 数据库配置
# ------------------------------------------
DATABASE_PATH=./database.sqlite

# ------------------------------------------
# 文件存储配置
# ------------------------------------------
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_FILE_SIZE=100MB

# ------------------------------------------
# AI 服务配置
# ------------------------------------------
# 默认 AI 服务提供商: openai, claude, gemini, qwen, volcengine
DEFAULT_AI_SERVICE=openai

# OpenAI 配置
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude 配置
# CLAUDE_API_KEY=sk-ant-xxx
# CLAUDE_BASE_URL=https://api.anthropic.com

# Gemini 配置
# GEMINI_API_KEY=xxx

# 通义千问配置
# QWEN_API_KEY=xxx

# 火山引擎配置
# VOLCENGINE_API_KEY=xxx

# ------------------------------------------
# 模型配置（可选）
# ------------------------------------------
# 格式: 模型ID:显示名称:能力1,能力2|模型ID:显示名称:能力1,能力2
# 能力类型: text(文本), image(图片), speech(语音), video(视频), embedding(嵌入)
# 如果不配置，将使用默认模型列表
#
# 示例:
# OPENAI_MODELS=gpt-4o:GPT-4o:text,image|gpt-4o-mini:GPT-4o Mini:text|dall-e-3:DALL-E 3:image|tts-1:TTS-1:speech
# CLAUDE_MODELS=claude-sonnet-4-20250514:Claude Sonnet 4:text|claude-3-5-sonnet-20241022:Claude 3.5 Sonnet:text
# GEMINI_MODELS=gemini-2.5-pro-preview-05-06:Gemini 2.5 Pro:text,image|gemini-2.0-flash:Gemini 2.0 Flash:text,image
# QWEN_MODELS=qwen-max:通义千问-Max:text|wanx-v1:通义万相:image|cosyvoice-v1:CosyVoice:speech
# VOLCENGINE_MODELS=doubao-pro-32k:豆包Pro 32K:text|doubao-vision-pro-32k:豆包Vision Pro 32K:text,image

# OpenAI 模型列表
# 默认包含: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-4, gpt-3.5-turbo, o1, o1-mini, o1-preview, o3-mini, dall-e-3, dall-e-2, tts-1, tts-1-hd, whisper-1
# OPENAI_MODELS=

# Claude 模型列表
# 默认包含: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# CLAUDE_MODELS=

# Gemini 模型列表
# 默认包含: gemini-2.5-pro-preview-05-06, gemini-2.5-flash-preview-05-20, gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-pro, gemini-1.5-flash, imagen-3.0-generate-002
# GEMINI_MODELS=

# 通义千问模型列表
# 默认包含: qwen-max, qwen-max-latest, qwen-plus, qwen-plus-latest, qwen-turbo, qwen-turbo-latest, qwen-vl-max, qwen-vl-plus, wanx-v1, wanx2.1-t2i-turbo, wanx2.1-t2i-plus, cosyvoice-v1, sambert-zhichu-v1
# QWEN_MODELS=

# 火山引擎模型列表
# 默认包含: doubao-pro-32k, doubao-pro-128k, doubao-pro-256k, doubao-lite-32k, doubao-lite-128k, doubao-vision-pro-32k, doubao-vision-lite-32k
# VOLCENGINE_MODELS=

# ------------------------------------------
# 安全配置
# ------------------------------------------
# API 密钥加密密钥 - 生产环境务必修改！
API_KEY_ENCRYPTION_SECRET=your-secret-key-change-in-production

# ------------------------------------------
# 日志配置
# ------------------------------------------
# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ------------------------------------------
# FFmpeg 配置
# ------------------------------------------
# FFmpeg 可执行文件路径 (如果已添加到 PATH 可留空)
# FFMPEG_PATH=/usr/bin/ffmpeg
