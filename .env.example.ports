# ==========================================
# 9Cut Docker 端口映射配置示例
# ==========================================

# ------------------------------------------
# 场景 1: 生产环境（推荐）
# ------------------------------------------
# 只开放 80 端口，后端通过 Nginx 反向代理访问
# 访问地址: http://your-server-ip
HTTP_PORT=80
# BACKEND_PORT=3000  # 不开放

# ------------------------------------------
# 场景 2: 80 端口被占用
# ------------------------------------------
# 使用 8080 端口作为主入口
# 访问地址: http://your-server-ip:8080
# HTTP_PORT=8080
# BACKEND_PORT=3000  # 不开放

# ------------------------------------------
# 场景 3: 开发调试模式
# ------------------------------------------
# 同时开放前端和后端端口，便于调试
# 前端访问: http://localhost:80
# 后端访问: http://localhost:3000/api
# HTTP_PORT=80
# BACKEND_PORT=3000

# ------------------------------------------
# 场景 4: 多服务共存
# ------------------------------------------
# 自定义端口避免冲突
# 前端访问: http://localhost:8080
# 后端访问: http://localhost:8001/api
# HTTP_PORT=8080
# BACKEND_PORT=8001

# ------------------------------------------
# 场景 5: 内网部署
# ------------------------------------------
# 使用非标准端口增加安全性
# 访问地址: http://your-server-ip:18080
# HTTP_PORT=18080
# BACKEND_PORT=13000

# ------------------------------------------
# 端口映射语法说明
# ------------------------------------------
# ${HTTP_PORT:-80}:80
# ├── HTTP_PORT: .env 文件中定义的环境变量
# ├── :-80: 默认值（如果 HTTP_PORT 未设置，使用 80）
# └── :80: 容器内部端口（固定不变）
#
# 示例：
# - HTTP_PORT=8080 → 宿主机 8080:容器 80
# - HTTP_PORT 未设置 → 宿主机 80:容器 80

# ------------------------------------------
# docker-compose.yml 中的对应配置
# ------------------------------------------
# ports:
#   - "${HTTP_PORT:-80}:80"
#   # - "${BACKEND_PORT:-3000}:3000"
#
# 如需开放后端端口：
# 1. 在 .env 中添加 BACKEND_PORT=3000
# 2. 在 docker-compose.yml 中取消注释后端端口行
# 3. 重启容器: docker-compose up -d

# ------------------------------------------
# 验证端口配置
# ------------------------------------------
# 查看当前端口映射:
# docker-compose ps
# 或
# docker ps --filter name=9cut-app

# 测试端口连通性:
# curl http://localhost:${HTTP_PORT}
# curl http://localhost:${HTTP_PORT}/api/health
